{
  "name": "lukaos-portfolio",
  "version": "1.0.0",
  "description": "A macOS-style portfolio website simulating a desktop operating system environment with React, TypeScript, and Tailwind CSS",
  "author": {
    "name": "Luka Dadiani",
    "email": "luka.taylor@gmail.com",
    "url": "https://meetluka.com"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/lukataylo/Portfolio-new-LukaOS"
  },
  "homepage": "https://meetluka.com",
  "keywords": [
    "portfolio",
    "react",
    "typescript",
    "tailwindcss",
    "macos",
    "desktop-environment",
    "vite",
    "pwa"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,css,md}\"",
    "analyze": "ANALYZE=true vite build",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-mono": "^5.2.9",
    "@google/genai": "^1.31.0",
    "@mdx-js/react": "^3.1.1",
    "@mdx-js/rollup": "^3.1.1",
    "isomorphic-dompurify": "^2.36.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.2",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-mdx-frontmatter": "^5.2.0",
    "workbox-window": "^7.4.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.5.0",
    "https-proxy-agent": "^9.0.0",
    "jsdom": "^25.0.1",
    "minipass": "^7.1.3",
    "postcss": "^8.5.13",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
